# Supabase Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=your-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (only use in server-side code, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ✅ SECURITY: Token secreto para autenticar chamadas à Edge Function de notificações
# Gere com: openssl rand -hex 32
# Configure também no painel Supabase: Edge Functions > notify-due-tasks > Secrets
CRON_SECRET=your-random-secret-here

# Gemini AI (ATENÇÃO: mover para Edge Function — não usar no cliente em produção)
# GEMINI_API_KEY=your-gemini-api-key-here
